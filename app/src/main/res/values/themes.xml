<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.S25PresetCam" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.S25PresetCam.Camera" parent="Theme.S25PresetCam">
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
